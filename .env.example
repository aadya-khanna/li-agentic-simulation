# Set LI_STUB=0 and provide at least one provider key to use real models.
LI_STUB=0
LI_DEFAULT_MODEL=gemini/gemini-flash-lite-latest
LI_MAX_TOKENS=500
LI_TEMPERATURE=0.85
LI_SCENE_TURNS=2
LI_SEASON_DAYS=7
LI_RPM=8
LI_MAX_RETRIES=8
LI_STUB_ON_ERROR=0

# high | low  (how often the £50k / survival frame is repeated)
LI_PRIZE_EMPHASIS=high
# 1 = ask for felt thought AND game-play as two private fields
LI_DUAL_THOUGHT=1

# Optional: different model per islander (LiteLLM model ids)
# LI_MODEL_MAYA=gpt-4o-mini
# LI_MODEL_LUCA=claude-3-5-haiku-latest
# LI_MODEL_ZARA=gemini/gemini-2.0-flash
# LI_MODEL_THEO=groq/llama-3.3-70b-versatile
# LI_MODEL_NIA=gpt-4o-mini
# LI_MODEL_KAI=gpt-4o-mini

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
